{
    "name": "codeigniter4/appstarter",
    "description": "CodeIgniter4 starter app",
    "license": "MIT",
    "type": "project",
    "homepage": "https://codeigniter.com",
    "support": {
        "forum": "https://forum.codeigniter.com/",
        "source": "https://github.com/codeigniter4/CodeIgniter4",
        "slack": "https://codeigniterchat.slack.com"
    },
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "firebase/php-jwt": "^7.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "Com\\Tecnick\\Pdf\\Encrypt\\": "app/ThirdParty/TCPDF/libs/tecnickcom/tc-lib-pdf-encrypt/src",
            "Com\\Tecnick\\Pdf\\Filter\\": "app/ThirdParty/TCPDF/libs/tecnickcom/tc-lib-pdf-filter/src",
            "Com\\Tecnick\\Pdf\\Font\\": "app/ThirdParty/TCPDF/libs/tecnickcom/tc-lib-pdf-font/src",
            "Com\\Tecnick\\Pdf\\Graph\\": "app/ThirdParty/TCPDF/libs/tecnickcom/tc-lib-pdf-graph/src",
            "Com\\Tecnick\\Pdf\\Image\\": "app/ThirdParty/TCPDF/libs/tecnickcom/tc-lib-pdf-image/src",
            "Com\\Tecnick\\Pdf\\Page\\": "app/ThirdParty/TCPDF/libs/tecnickcom/tc-lib-pdf-page/src",
            "Com\\Tecnick\\Pdf\\Parser\\": "app/ThirdParty/TCPDF/libs/tecnickcom/tc-lib-pdf-parser/src",
            "Com\\Tecnick\\Pdf\\Sign\\": "app/ThirdParty/TCPDF/libs/tecnickcom/tc-lib-pdf-sign/src",
            "Com\\Tecnick\\Pdf\\": "app/ThirdParty/TCPDF/libs/tecnickcom/tc-lib-pdf/src",
            "Com\\Tecnick\\Unicode\\Data\\": "app/ThirdParty/TCPDF/libs/tecnickcom/tc-lib-unicode-data/src",
            "Com\\Tecnick\\Unicode\\": "app/ThirdParty/TCPDF/libs/tecnickcom/tc-lib-unicode/src",
            "Com\\Tecnick\\Barcode\\": "app/ThirdParty/TCPDF/libs/tecnickcom/tc-lib-barcode/src",
            "Com\\Tecnick\\Color\\": "app/ThirdParty/TCPDF/libs/tecnickcom/tc-lib-color/src",
            "Com\\Tecnick\\File\\": "app/ThirdParty/TCPDF/libs/tecnickcom/tc-lib-file/src"
        },
        "classmap": [
            "app/ThirdParty/TCPDF/config",
            "app/ThirdParty/TCPDF/tcpdf.php"
        ],
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
